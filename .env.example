# Server-only. Copy to .env.local and fill in privately. Never paste secrets into chat.
# URL-encode username/password components. Use the actual database from Connect.
DATABASE_URL=
# Optional PEM certificate contents (escaped newlines supported). TLS verification is always on.
DATABASE_CA_CERT=
# Optional Gemini API. AI routes are disabled unless both the key and explicit
# opt-in are present. Never set NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Conservative app caps (hard-capped in code at 3/user/day and 30/app/day).
AI_DAILY_USER_LIMIT=3
AI_DAILY_GLOBAL_LIMIT=30
APP_URL=http://localhost:3000
# Random server-only secret (at least 32 characters) for rate-limit identity hashing.
# Generate locally with Node crypto.randomBytes(32).toString('hex'); never commit it.
AUTH_SECRET=
